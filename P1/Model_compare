# Import libraries for working with Fashion-MNIST dataset, displaying images, and numerical operations 
from tensorflow.keras.datasets import fashion_mnist
import matplotlib.pyplot as plt
import numpy as np
# Import scikit-learn libraries for model evaluation and training
from sklearn.model_selection import train_test_split
from sklearn.linear_model import LogisticRegression
from sklearn.metrics import accuracy_score, classification_report, confusion_matrix, ConfusionMatrixDisplay

# Loading the training, testing data and selecting the target variables
(x_train, y_train), (x_test, y_test) = fashion_mnist.load_data()

# Converting image values to floating-point numbers
x_train = x_train.astype("float32") / 255.0
x_test = x_test.astype("float32") / 255.0
# Flattening 28x28 images into 1D arrays of 784 features 
x_train_flat = x_train.reshape(x_train.shape[0], -1)
x_test_flat = x_test.reshape(x_test.shape[0], -1)

# Names of the ten classes
classes = ["T-shirt/top","Trouser","Pullover","Dress","Coat","Sandal","Shirt","Sneaker","Bag","Ankle boot"]

# Split the training data into training and validation sets
x_train_flat, x_val_flat, y_train, y_val = train_test_split(x_train_flat, y_train, test_size=0.2, random_state=42)

# Initialising the logistic regression classifier
model_1 = LogisticRegression(max_iter=1000)
model_2 = LogisticRegression(penalty="l2",C=0.1,solver="lbfgs",max_iter=1000,random_state=42)

# Training both models on the training data
model_1.fit(x_train_flat, y_train)
model_2.fit(x_train_flat, y_train)

# Validation predictions for both models
y_val_pred = model_1.predict(x_val_flat)
y_val_pred_2 = model_2.predict(x_val_flat)

# Test predictions for both models
y_test_pred = model_1.predict(x_test_flat)
y_test_pred_2 = model_2.predict(x_test_flat)

# Validation accuracy for both models
val_accuracy = accuracy_score(y_val, y_val_pred)
val_accuracy_2 = accuracy_score(y_val, y_val_pred_2)

# Test accuracy for both models
test_accuracy = accuracy_score(y_test, y_test_pred)
test_accuracy_2 = accuracy_score(y_test, y_test_pred_2)

# Displaying the comparison results
print("MODEL COMPARISON RESULTS")
print("\nValidation Accuracy:")
print("Model 1:", val_accuracy)
print("Model 2:", val_accuracy_2)
print("\nTest Accuracy:")
print("Model 1:", test_accuracy)
print("Model 2:", test_accuracy_2)

print("\nValidation Accuracy Comparison:")
print("Model 1:", val_accuracy)
print("Model 2:", val_accuracy_2)

print("\nTest Accuracy Comparison:")
print("Model 1:", test_accuracy)
print("Model 2:", test_accuracy_2)

print("\nValidation Accuracy Difference:")
print("Difference:", abs(val_accuracy - val_accuracy_2))

print("\nTest Accuracy Difference:")
print("Difference:", abs(test_accuracy - test_accuracy_2))

print("\nSummary:")
print("Validation Accuracy - Model 1:", val_accuracy, "Model 2:", val_accuracy_2)
print("Test Accuracy - Model 1:", test_accuracy, "Model 2:", test_accuracy_2)
print("Validation Accuracy Difference:", abs(val_accuracy - val_accuracy_2))
print("Test Accuracy Difference:", abs(test_accuracy - test_accuracy_2))